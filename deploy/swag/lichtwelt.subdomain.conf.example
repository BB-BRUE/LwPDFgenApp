server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name lichtwelt.bartenbach.com;

    include /config/nginx/ssl.conf;

    client_max_body_size 50m;

    # Nur freigegebene Quell-IP-Adressen dürfen PDFs abrufen.
    location ^~ /pdf/ {
        # Weitere erlaubte Adressen bei Bedarf ergänzen.
        # allow 203.0.113.25;
        allow 91.118.9.128/28;
        deny all;

        error_page 403 = @pdf_startseite;

        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;

        set $upstream_app lwpdfgen;
        set $upstream_port 8000;
        set $upstream_proto http;

        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }

    # Gesperrte PDF-Aufrufe werden auf die öffentliche Startseite umgeleitet.
    location @pdf_startseite {
        return 302 /index.html;
    }

    # Flask liefert Startseite, Assets, Verwaltung und Fehlerseiten aus.
    location / {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;

        set $upstream_app lwpdfgen;
        set $upstream_port 8000;
        set $upstream_proto http;

        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }
}